# ── Application ───────────────────────────────────────────────
APP_NAME=Aahaar API
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1

# ── Database ──────────────────────────────────────────────────
# Async SQLAlchemy URL (asyncpg driver).
DATABASE_URL=postgresql+asyncpg://aahaar:aahaar@localhost:5432/aahaar

# ── Security / JWT ────────────────────────────────────────────
# CHANGE THIS in production — used to sign JWTs.
SECRET_KEY=change-me-in-production-please-use-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
JWT_ALGORITHM=HS256

# ── CORS ──────────────────────────────────────────────────────
# Comma-separated list of allowed origins for the customer + dashboard apps.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:3000

# ── Realtime ──────────────────────────────────────────────────
# Optional Redis URL for horizontally-scaled Socket.IO. Leave blank for single-process.
REDIS_URL=

# ── Customer app base URL (used to build QR target links) ─────
CUSTOMER_APP_BASE_URL=http://localhost:5174

# ── Clerk (Google login). See restaurant_qr_platform_documentation/clerk.md
CLERK_SECRET_KEY=
CLERK_AUTHORIZED_PARTIES=http://localhost:5173,http://localhost:5174,http://localhost:5175

# ── Super admin (comma-separated emails). These skip the waitlist.
SUPER_ADMIN_EMAILS=atharvrege722@gmail.com

# ── Waitlist notifications
# Gmail: create an App Password, then set SMTP_USER to the Gmail address.
ADMIN_NOTIFY_EMAIL=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
# Twilio WhatsApp (optional). Example: ADMIN_WHATSAPP_TO=+9198xxxxxxxx
ADMIN_WHATSAPP_TO=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# ── Rate limiting (requests per window, seconds) ─────────────
RATE_LIMIT_LOGIN=10/60
RATE_LIMIT_ORDER=30/60
RATE_LIMIT_PUBLIC=120/60

VITE_CLERK_PUBLISHABLE_KEY=pk_test_ZXRlcm5hbC1tb3JheS05OTU1LmNsZXJrLmFjY291bnRzLmRldiQ
