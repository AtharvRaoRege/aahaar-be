# Local Postgres (docker compose db on 5433)
DATABASE_URL=postgresql+asyncpg://aahaar:aahaar@localhost:5433/aahaar

# JWT signing — change this before production
SECRET_KEY=change-me-in-production-please-use-a-long-random-string

# Guest QR links
CUSTOMER_APP_BASE_URL=http://localhost:5174

# Browser origins (comma-separated). https://aahaar.callybre.com is always allowed.
# CORS_ORIGINS=https://aahaar.callybre.com
# CLERK_AUTHORIZED_PARTIES=https://aahaar.callybre.com

# Google login (Clerk). Leave blank to disable.
CLERK_SECRET_KEY=

# Super admins are not configured here. Platform access is a column on the user:
#   update users set platform_role = 'SUPER_ADMIN' where email = 'you@example.com';
#   update users set platform_role = 'USER'        where email = 'you@example.com';
# Takes effect on the account's next request — no redeploy, no re-login.

# Supabase — fill when you link a project
# DATABASE_URL=postgresql+asyncpg://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Gemini AI menu scan. Leave blank to hide the scan action in the dashboard.
# GEMINI_API_KEY=
